# ─────────────────────────────────────────────────────────────────────────
# Attentt — environment configuration
# Copy to `.env.local` for local dev. NEVER commit real secrets.
# Every secret here is server-side only unless prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────

# ── App ──
# Public base URL of the app (used for OAuth redirects, push links, Stripe).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──
# Project URL and the anon (public) key are safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key: SERVER ONLY. Used by Edge Functions / cron / webhooks that
# must bypass RLS (e.g. the nudge engine). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Encryption ──
# 32-byte base64 key used to encrypt calendar OAuth tokens at rest (§12).
# Generate: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=base64-32-byte-key

# ── Web Push (VAPID) ──
# Generate a keypair with `npm run gen:vapid`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# ── Anthropic (AI) ──
# Server-side ONLY. Used for reel parsing, suggestions and message drafting.
ANTHROPIC_API_KEY=sk-ant-...
# Default model for app AI calls.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Google Calendar (OAuth) ──
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Price ID for the Attentt membership subscription.
STRIPE_SUBSCRIPTION_PRICE_ID=price_...

# ── Nudge engine (testing) ──
# When true, escalation timings are compressed to minutes for local testing (§6).
NUDGE_COMPRESSED_TIME=false
# Shared secret protecting the cron evaluate endpoint from public calls.
NUDGE_CRON_SECRET=change-me
